# Copy to .env (local) and set the same names in Vercel / GitHub Actions secrets.
# Never commit real values.

# ----- Supabase -----
SUPABASE_URL=https://your-project-ref.supabase.co
# Public key: safe in the browser ONLY because RLS + the `api` schema protect the data
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only: bypasses ALL RLS policies. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ----- Anthropic (surveillance agent, GitHub Actions only) -----
ANTHROPIC_API_KEY=sk-ant-your-key

# ----- GitHub (server-only; fine-grained PAT with actions:write on this repo, to trigger workflows) -----
GITHUB_WORKFLOW_TOKEN=your-fine-grained-pat

# ----- News sources for the agent (GDELT -> NewsAPI -> RSS -> mock) -----
GDELT_ENABLED=true
NEWS_API_KEY=your-newsapi-key

# ----- Local data pipeline -----
CREWS_RAW_DIR=data/raw
CREWS_SAMPLE_SIZE=2000
CREWS_SAMPLE_SEED=42
