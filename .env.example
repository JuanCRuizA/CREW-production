# Copy to .env (local) and set the same names in Render / GitHub Actions secrets.
# Never commit real values.

# ----- Simple-deploy path (Flask on Render + Supabase Postgres); see docs/DEPLOY_SIMPLE.md -----
# Session pooler URIs (IPv4). Percent-encode reserved characters in passwords (& # ? / @ space).
# App connection: least-privilege role crew_app. Set in Render; locally only for smoke tests.
DATABASE_URL=postgresql://crew_app.your-project-ref:your-crew-app-password@aws-0-us-west-2.pooler.supabase.com:5432/postgres?sslmode=require
# Admin connection: postgres role, used ONLY by pipelines/load_sample.py on your machine. Never in Render.
DATABASE_URL_ADMIN=postgresql://postgres.your-project-ref:your-db-password@aws-0-us-west-2.pooler.supabase.com:5432/postgres?sslmode=require
# Flask session signing key. Render generates its own; locally: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your-random-hex

# ----- Supabase API keys (Vercel/Next.js path; UNUSED on the simple-deploy path) -----
SUPABASE_URL=https://your-project-ref.supabase.co
# Public key: safe in the browser ONLY because RLS + the `api` schema protect the data
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only: bypasses ALL RLS policies. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ----- Anthropic (surveillance agent, GitHub Actions only) -----
ANTHROPIC_API_KEY=sk-ant-your-key

# ----- GitHub (server-only; fine-grained PAT with actions:write on this repo, to trigger workflows) -----
GITHUB_WORKFLOW_TOKEN=your-fine-grained-pat

# ----- News sources for the agent (GDELT -> NewsAPI -> RSS -> mock) -----
GDELT_ENABLED=true
NEWS_API_KEY=your-newsapi-key

# ----- Local data pipeline -----
CREWS_RAW_DIR=data/raw
CREWS_SAMPLE_SIZE=2000
CREWS_SAMPLE_SEED=42
